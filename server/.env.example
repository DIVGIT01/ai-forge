# Copy to server/.env and fill in. Never commit the filled-in file.

# --- Server ---------------------------------------------------------------
# Keep this on loopback. Use a reverse proxy or an SSH tunnel if you need the
# API from another machine - do not widen the bind.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Comma-separated browser origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# --- Database (required) --------------------------------------------------
# Neon serverless Postgres: https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Clerk auth (required) ------------------------------------------------
# https://dashboard.clerk.com -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Google Gemini (article writer, blog titles, resume review) -----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- ClipDrop (text-to-image) --------------------------------------------
# https://clipdrop.co/apis
CLIPDROP_API_KEY=

# --- Cloudinary (image hosting, background + object removal) -------------
# https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Limits ---------------------------------------------------------------
# Free-plan generations before a Premium upgrade is required.
FREE_USAGE_LIMIT=10
